# .env 로 복사한 뒤 값을 채우세요. .env 는 커밋하지 않습니다 (NF3001).

# 공공데이터포털 — TourAPI(15101578), TAGO 고속버스(15098522)·시외버스(15098541)·열차(15098552),
# 기상청 단기(15084084)·중기(15059468), 특일(15012690), 관광지 집중률(15128555)
# API 마다 '활용신청'을 따로 해야 합니다. 신청하지 않은 API 는 403(코드 30)이 납니다.
DATA_GO_KR_SERVICE_KEY=

# 카카오 REST 키 — 로컬(카페·음식점) + 모빌리티 길찾기(자가용)
KAKAO_REST_API_KEY=

# YouTube Data API v3 (Google Cloud) — 하루 10,000 단위, 검색 1회 100 단위
YOUTUBE_API_KEY=

# ODsay LAB (선택) — 현지 대중교통 상세. 없으면 카카오맵 길찾기 링크로 대신함
ODSAY_API_KEY=

# LLM
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# 2회차 국보 RAG 저장소 경로 (F3022). 예: ../heritage-rag-guide
HERITAGE_RAG_DIR=

# 실행 설정
MAX_REPLAN=3
HTTP_TIMEOUT=10
PLANNER_DB=data/planner.db

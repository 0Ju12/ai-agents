# 개인 PC는 local, 공개 HTTPS 서버는 server
FRIDGE_MODE=local
FRIDGE_DATA_DIR=./data
GMS_KEY=
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
GMS_MODEL=gpt-6.1-sol
# 1 이면 /v1/responses, 0 이면 /v1/chat/completions
GMS_RESPONSES_API=1
WORKER_LLM=1
# 자연어 요청에서 모델이 보조 도구 계획(PLANNER_LLM)과 결과 문장(ANSWER_LLM)을 맡는다. 0 이면 규칙만
PLANNER_LLM=1
ANSWER_LLM=1
FOODSAFETY_API_KEY=
DATA_GO_KR_SERVICE_KEY=
MEALDB_API_KEY=
USDA_API_KEY=
KAKAO_REST_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
YOUTUBE_API_KEY=
IG_USER_ID=
IG_ACCESS_TOKEN=
META_GRAPH_VERSION=v25.0
HERITAGE_RAG_DIR=
RAG_EMBED_MODEL=text-embedding-3-small
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# 개인 PC는 local, 공개 HTTPS 서버는 server
FRIDGE_MODE=local
FRIDGE_DATA_DIR=./data
GMS_KEY=
GMS_ANTHROPIC_MODEL=claude-opus-5-5
# OpenAI 호환 채팅이 필요한 경우 GMS_PROVIDER=openai와 GMS_MODEL을 지정하세요.
WORKER_LLM=1
# 자연어 요청에서 모델이 보조 도구 계획(PLANNER_LLM)과 결과 문장(ANSWER_LLM)을 맡는다. 0 이면 규칙만
PLANNER_LLM=1
ANSWER_LLM=1
FOODSAFETY_API_KEY=
DATA_GO_KR_SERVICE_KEY=
MEALDB_API_KEY=
USDA_API_KEY=
KAKAO_REST_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
YOUTUBE_API_KEY=
IG_USER_ID=
IG_ACCESS_TOKEN=
META_GRAPH_VERSION=v25.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# 조리 모드 미디어 (선택): 모델 보충 끄기 GUIDE_LLM=0 · VIDEO_LLM=0
GUIDE_LLM=1
VIDEO_LLM=1
# AI 조리 클립 생성 도구(media_tools/make_clips.py) 전용 · 서버 실행에는 필요 없음
CLIP_PROVIDER=
CLIP_API_URL=
CLIP_API_KEY=
CLIP_COMMAND=
# 빈 냉장고를 예시 재료로 채우기 (python app.py 실행 시 기본 1) · 상황 문장 자동 진행에서 모델 사용
FRIDGE_DEMO=1
AUTOPILOT_LLM=1
